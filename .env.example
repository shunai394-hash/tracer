# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=

# Bright Data (server only)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=
BRIGHTDATA_MCP_URL=

# CJdropshipping (server only)
CJ_API_KEY=
# Real supplier order execution stays off until this is explicitly "1".
CJ_LIVE_ORDERING=0

# Shopify Admin API (server only) — the source of truth for actual revenue/orders.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=

# Meta Marketing API (server only) — ad-media-reported metrics only, not actual revenue.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=

# NEWFIND bridge (server only)
NEWFIND_WEBHOOK_SECRET=
NEWFIND_API_URL=
NEWFIND_API_KEY=

# Teacher AI: weight updates only apply when this is explicitly "1".
TEACHER_APPLY_WEIGHTS=0

# Protects cron/webhook route handlers when set.
CRON_SECRET=

# Stripe (server only) — the single source of truth for payment confirmation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe Checkout success/cancel redirect URLs (e.g. https://your-domain.com).
NEXT_PUBLIC_SITE_URL=

# orosy Buyer API (server only). "demo"/"live" is set explicitly here, never
# guessed from the key string. /simulate is only callable when demo.
# The two keys never fall back to each other: OROSY_ENVIRONMENT=demo uses
# OROSY_DEMO_API_KEY only, OROSY_ENVIRONMENT=live uses OROSY_API_KEY only.
# Leaving the matching key unset means orosy is treated as not configured.
OROSY_ENVIRONMENT=demo
OROSY_DEMO_API_KEY=
OROSY_API_KEY=
# Real supplier order execution (POST /v1/orders actually firing) stays off until this is explicitly "1".
OROSY_LIVE_ORDERING=0
