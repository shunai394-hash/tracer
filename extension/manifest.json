{
  "manifest_version": 3,
  "name": "TRACER Product Capture",
  "version": "0.1.0",
  "description": "Capture Amazon product data and send it to TRACER.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*.amazon.com/*", "https://*.amazon.co.jp/*", "https://*.vercel.app/*"],
  "action": {
    "default_title": "Send product to TRACER",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.com/*", "https://*.amazon.co.jp/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
