{
  "name": "tracer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:tracer-core": "node --test scripts/tracer-core.test.mjs scripts/tracer-auth-contract.test.mjs",
    "mobile:bootstrap": "node scripts/bootstrap-mobile.mjs",
    "prebuild": "node scripts/test-internal-api-auth.mjs && node scripts/test-auth-diagnostics.mjs && npm run test:shopify-line-item-pagination && npm run test:autonomous-order-claim && npm run test:dropship-order-gate && npm run test:bounded-product-scoring && npm run test:bounded-reorder-recommendations && npm run test:bounded-identity-stamping",
    "test:auth-diagnostics": "node scripts/test-auth-diagnostics.mjs",
    "test:bounded-product-scoring": "node scripts/test-bounded-product-scoring.mjs",
    "test:bounded-reorder-recommendations": "node scripts/test-bounded-reorder-recommendations.mjs",
    "test:bounded-identity-stamping": "node scripts/test-bounded-identity-stamping.mjs",
    "test:dropship-order-gate": "node --experimental-strip-types --no-warnings scripts/test-dropship-order-gate.mjs",
    "test:shopify-line-item-pagination": "node scripts/test-shopify-line-item-pagination.mjs",
    "test:autonomous-order-claim": "node scripts/test-autonomous-order-run-claim.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
