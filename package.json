    "test:auth-diagnostics": "node scripts/test-auth-diagnostics.mjs",
    "test:dropship-order-gate": "node --experimental-strip-types --no-warnings scripts/test-dropship-order-gate.mjs",
    "test:shopify-line-item-pagination": "node scripts/test-shopify-line-item-pagination.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
