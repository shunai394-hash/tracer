{
  "name": "tracer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:tracer-core": "node --test scripts/tracer-core.test.mjs scripts/tracer-auth-contract.test.mjs",
    "mobile:bootstrap": "node scripts/bootstrap-mobile.mjs",
