    },
    {
      "path": "/api/cron/inventory-refresh",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/base-publish",
      "schedule": "22 5 * * *"
    },
    {
      "path": "/api/cron/dropship-execution",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/supplier-reconciliation",
      "schedule": "35 12 * * *"
    },
    {
      "path": "/api/cron/supplier-orders",
      "schedule": "40 12 * * *"
