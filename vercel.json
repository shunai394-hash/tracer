{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/market-sourcing",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/supplier-investigation",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/cron/sales-test-publication",
